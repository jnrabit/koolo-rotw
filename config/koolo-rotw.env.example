# Kopieren nach ~/.config/koolo-rotw.env und anpassen.
# Wird vom Startskript per `source` geladen - nur Zuweisungen, keine Befehle.

KOOLO_HOME="$HOME/.var/app/com.usebottles.bottles/data/bottles/bottles/Gaming/drive_c/koolo-rotw"
STEAM_HOME="$HOME/.local/share/Steam"
STEAM_GAME_ID=2998511494
#PROTON_PATH="$STEAM_HOME/steamapps/common/Proton - Experimental/proton"
API_PORT=8087
TASKSET_CPUS="6-7,14-15"
NICE_LEVEL=15

# --- Optionale Hooks (leer = inaktiv) ------------------------------------------
# Laufen in einer eigenen bash; Fehler brechen Start/Stop nicht ab.
# Eigene Streaming-Variablen bitte mit STREAM_-Praefix benennen.
#POST_START_CMD="cd $HOME/d2r_streaming && ./start_stream.sh"
#PRE_STOP_CMD="pkill -f d2r_unified_stream || true"

